# Required TPN credentials - add these in your host's secret/environment settings.
TPN_USERNAME=
TPN_PASSWORD=

# Required secret used to protect the manual /refresh endpoint.
REFRESH_TOKEN=replace-with-a-long-random-secret

# TPN staging login.
TPN_LOGIN_URL=https://staging.tpnconnect.com/

# Browser automation.
HEADLESS=true
DATE_FORMAT=%d/%m/%Y

# Scheduler.
ENABLE_SCHEDULER=true
REFRESH_MINUTES=15
TIMEZONE=Europe/London

# Optional bank holidays, comma-separated ISO dates.
# Example: 2026-12-25,2026-12-28
BANK_HOLIDAYS=
